rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access status: the customer can read it, only the server can write it.
    match /users/{uid}/meta/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // The customer's app data: only the owner, and only with active access.
    match /users/{uid}/app/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)/meta/license).data.active == true;
    }

    // Payment records: server only.
    match /entitlements/{id} {
      allow read, write: if false;
    }
  }
}
